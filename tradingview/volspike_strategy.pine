//@version=6
strategy("VolSpike Strategy", "VolSpikeStrat", overlay=true, max_labels_count=200,
     initial_capital=50000, currency=currency.USD,
     default_qty_type=strategy.percent_of_equity, default_qty_value=100, pyramiding=0,
     slippage=1, commission_type=strategy.commission.percent, commission_value=0.0,
     process_orders_on_close=true, calc_on_every_tick=false)

// ════════ ENTRY SIGNAL — identical to the VolSpike indicator ════════
// ── Window ──
winMin  = input.int(5, "Move window (minutes)", minval=1, group="Window")
tfSec   = timeframe.in_seconds()
winBars = int(math.max(1, math.round(winMin * 60 / tfSec)))
// ── Price ──
pctThr  = input.float(0.5, "Min move over window (%)", minval=0.0, step=0.1, group="Price")
useUp   = input.bool(true, "Up moves",   inline="d", group="Price")
useDn   = input.bool(true, "Down moves", inline="d", group="Price")
dolThr  = 2.0
basePx  = close[winBars]
pctChg  = (close - basePx) / basePx * 100.0
dolChg  = close - basePx
upPct   = useUp and pctChg >=  pctThr
dnPct   = useDn and pctChg <= -pctThr
upDol   = useUp and dolChg >=  dolThr
dnDol   = useDn and dolChg <= -dolThr
// ── Volume ──
volMult   = input.float(1.5, "Min volume multiple (% path)", minval=1.0, step=0.1, group="Volume")
volMultLt = input.float(1.2, "Min volume multiple ($ path)", minval=1.0, step=0.1, group="Volume")
basis     = input.string("Session running average", "Baseline", options=["Session running average", "Rolling average (last N bars)"], group="Volume")
rollLen   = input.int(20, "Rolling length (bars)", minval=1, group="Volume")
newDay  = barstate.isfirst or ta.change(time("D")) != 0
var float sessVol  = 0.0
var int   sessBars = 0
sessVol  := newDay ? volume : sessVol + volume
sessBars := newDay ? 1 : sessBars + 1
avgBar   = sessVol / sessBars
winVol  = math.sum(volume, winBars)
baseVol = basis == "Rolling average (last N bars)" ? ta.sma(volume, rollLen) * winBars : avgBar * winBars
volRto  = baseVol > 0 ? winVol / baseVol : na
volHit     = not na(volRto) and volRto >= volMult
volHitLite = not na(volRto) and volRto >= volMultLt
// ── Trade window ──
actSess  = input.session("0730-1230", "Trade window (PT)", group="Session")
inWindow = not na(time(timeframe.period, actSess, "America/Los_Angeles"))
upHit = (upPct and volHit) or (upDol and volHitLite)
dnHit = (dnPct and volHit) or (dnDol and volHitLite)
upSig = upHit and inWindow
dnSig = dnHit and inWindow

// ════════ STRATEGY ════════
mode = input.string("Momentum", "Trade mode", options=["Momentum", "Reversion"], group="Strategy",
     tooltip="Momentum = trade WITH the spike (up->long, down->short). Reversion = fade it (up->short, down->long). Test both.")
isMom   = mode == "Momentum"
goLong  = isMom ? upSig : dnSig
goShort = isMom ? dnSig : upSig

useATR = input.bool(true, "ATR-based TP/SL", group="Exits",
     tooltip="ON = TP/SL as ATR multiples (adapts to volatility). OFF = fixed %.")
atrLen = input.int(14, "ATR length", minval=1, group="Exits")
tpATR  = input.float(2.0,  "Take profit (x ATR)", minval=0.0, step=0.25, group="Exits")
slATR  = input.float(1.5,  "Stop loss (x ATR)",   minval=0.0, step=0.25, group="Exits")
tpPct  = input.float(0.5,  "Take profit (%)", minval=0.0, step=0.05, group="Exits")
slPct  = input.float(0.35, "Stop loss (%)",   minval=0.0, step=0.05, group="Exits")
useTimeStop = input.bool(true, "Max-hold exit", group="Exits")
maxBars     = input.int(12, "Max hold (bars)", minval=1, group="Exits", tooltip="On 5m, 12 bars = 60 min.")
flatEOD     = input.bool(true, "Flat before the close", group="Exits")

atrv = ta.atr(atrLen)

// entries only when flat
if strategy.position_size == 0
    if goLong
        strategy.entry("Long", strategy.long)
    else if goShort
        strategy.entry("Short", strategy.short)

// track entry bar for the time stop
var int entryBar = na
if strategy.position_size != 0 and strategy.position_size[1] == 0
    entryBar := bar_index

// TP/SL distances from the average entry price
slDist = useATR ? slATR * atrv : strategy.position_avg_price * slPct / 100.0
tpDist = useATR ? tpATR * atrv : strategy.position_avg_price * tpPct / 100.0

if strategy.position_size > 0
    strategy.exit("exit L", from_entry="Long",  stop=strategy.position_avg_price - slDist, limit=strategy.position_avg_price + tpDist)
if strategy.position_size < 0
    strategy.exit("exit S", from_entry="Short", stop=strategy.position_avg_price + slDist, limit=strategy.position_avg_price - tpDist)

// max-hold time stop
if useTimeStop and strategy.position_size != 0 and not na(entryBar) and (bar_index - entryBar) >= maxBars
    strategy.close_all(comment="time")

// flat before the regular-session close (13:00 PT)
barMin    = tfSec / 60.0
closeMs   = timestamp("America/Los_Angeles", year(time, "America/Los_Angeles"), month(time, "America/Los_Angeles"), dayofmonth(time, "America/Los_Angeles"), 13, 0)
toClose   = (closeMs - time) / 60000.0
isLastBar = toClose > 0 and toClose <= barMin
if flatEOD and isLastBar and strategy.position_size != 0
    strategy.close_all(comment="eod")

// ── Visualize the active stop / target ──
plot(strategy.position_size != 0 ? (strategy.position_size > 0 ? strategy.position_avg_price - slDist : strategy.position_avg_price + slDist) : na, "Stop",   color.new(color.red,   0), style=plot.style_linebr)
plot(strategy.position_size != 0 ? (strategy.position_size > 0 ? strategy.position_avg_price + tpDist : strategy.position_avg_price - tpDist) : na, "Target", color.new(color.green, 0), style=plot.style_linebr)
