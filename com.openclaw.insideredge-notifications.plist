<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.openclaw.form4-notifications</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/python3</string>
        <string>/Users/derekg/trading-framework/pipelines/notification_scanner.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/derekg/trading-framework</string>

    <!-- Matches the ingest cadence. insider_fetch runs every 300s, so
         scanning more often than that finds nothing new; scanning less often
         adds pure latency to the product's core promise. At 900s a filing
         could sit up to 15 minutes after ingest before anyone was told, on
         top of the ~4 minute ingest. The scan itself takes 1.9 seconds. -->
    <key>StartInterval</key>
    <integer>300</integer>

    <key>StandardOutPath</key>
    <string>/Users/derekg/trading-framework/logs/notification_scanner.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/derekg/trading-framework/logs/notification_scanner.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>PYTHONPATH</key>
        <string>/Users/derekg/trading-framework</string>
    </dict>
</dict>
</plist>
