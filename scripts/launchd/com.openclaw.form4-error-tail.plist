<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.openclaw.form4-error-tail</string>

    <!-- Long-lived: the script does `docker logs --follow`. KeepAlive so it
         reattaches after a deploy restarts the API container, which it
         otherwise would not survive. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/derekg/trading-framework/scripts/api_error_tail.sh</string>
    </array>

    <key>KeepAlive</key>
    <true/>
    <key>RunAtLoad</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>30</integer>

    <key>WorkingDirectory</key>
    <string>/Users/derekg/trading-framework</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/derekg/trading-framework/logs/form4-error-tail.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/derekg/trading-framework/logs/form4-error-tail.log</string>
</dict>
</plist>
